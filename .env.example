# Copy to .env for optional local configuration. Never commit .env.
# Without a provider and UI consent, processing is extractive and stays local.
BRAIN_DB=data/brain.sqlite
# HTTPS self-hosting behind a TLS proxy; leave unset for local operation.
# BRAIN_PUBLIC_ORIGIN=https://brain.example.com

# --- Managed accounts (not a public release yet) -----------------------------
# BRAIN_MODE selects the runtime: "local" (default) or "managed". Managed mode
# requires every field below and fails closed when one is missing. It never
# adopts the local database. The server and worker read the same values.
# BRAIN_MODE=managed
# One absolute directory outside this repository that holds only managed data.
# BRAIN_MANAGED_ROOT=/var/lib/bibrain/managed
# The exact HTTPS origin this deployment is served from (one bare origin).
# BRAIN_PUBLIC_ORIGIN=https://brain.example.com
# Standards-based OIDC. The secret stays server-side and is never logged.
# BRAIN_OIDC_ISSUER=https://id.example.com
# BRAIN_OIDC_CLIENT_ID=
# BRAIN_OIDC_CLIENT_SECRET=
# Fixed callback path; defaults to /auth/callback.
# BRAIN_OIDC_CALLBACK_PATH=/auth/callback
# Managed paid processing is gated off: enabling it in the UI fails explicitly
# pending durable reconciliation and restart/cross-process activation safeguards.
# Central accounting exists; a policy or shared provider key does not enable it.
# Managed spending policy is written only by the trusted operator CLI against one
# explicit existing absolute managed root; there is no default root:
#   BRAIN_MANAGED_ROOT=/srv/bi-brain/managed npm run managed:policy -- set-service 30
#   npm run managed:policy -- configure-period <account_id> <start ISO Z> <end ISO Z> <allowance_micro_usd>
#   npm run managed:policy -- set-account <account_id> <per_job_micro_usd> <user_daily_micro_usd>
# The activation flag below is read by the operator process only. Paid processing
# stays OFF in this build regardless of the flag, and the flag is not a browser
# field; leaving it unset is the safe default.
# BRAIN_MANAGED_ALLOW_PAID=0
# Optional owner pairing secret; leave unset to generate data/owner-secret.
# BRAIN_OWNER_SECRET=
# Configure verified values from your provider account; no prices are guessed.
# OPENAI_API_KEY=
# Use an operator-verified concrete model id. An unexpected returned model keeps
# its charge unknown and held; model aliases are not silently inferred.
# BRAIN_MODEL=
# BRAIN_INPUT_MICRO_USD_PER_MILLION=
# BRAIN_OUTPUT_MICRO_USD_PER_MILLION=
# BRAIN_PRICE_VERSION=
# Optional provider-enforced output limit: integer 1..8000, default 2000.
# BRAIN_MAX_OUTPUT_TOKENS=2000
# Agent token belongs in your native client environment, not the browser.
# BRAIN_AGENT_TOKEN=
# BRAIN_API_URL=http://127.0.0.1:4317
