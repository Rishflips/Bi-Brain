# Copy to .env for optional local configuration. Never commit .env.
# Without a provider and UI consent, processing is extractive and stays local.
BRAIN_DB=data/brain.sqlite
# Optional owner pairing secret; leave unset to generate data/owner-secret.
# BRAIN_OWNER_SECRET=
# Configure verified values from your provider account; no prices are guessed.
# OPENAI_API_KEY=
# BRAIN_MODEL=
# BRAIN_INPUT_MICRO_USD_PER_MILLION=
# BRAIN_OUTPUT_MICRO_USD_PER_MILLION=
# BRAIN_PRICE_VERSION=
# Agent token belongs in your native client environment, not the browser.
# BRAIN_AGENT_TOKEN=
# BRAIN_API_URL=http://127.0.0.1:4317
