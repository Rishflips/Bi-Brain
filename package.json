{
  "name": "bi-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/run.mjs dev",
    "start": "node --env-file-if-exists=.env scripts/run.mjs production",
    "server": "node --env-file-if-exists=.env --import tsx apps/server/main.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/main.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "brain-eval": "node scripts/brain-eval.mjs",
    "import:folder": "node --env-file-if-exists=.env --import tsx scripts/import-folder.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "managed:policy": "node --env-file-if-exists=.env --import tsx scripts/managed-policy.ts",
    "managed:activation": "node --env-file-if-exists=.env --import tsx scripts/managed-activation.ts",
    "managed:decision-activation": "node --env-file-if-exists=.env --import tsx scripts/managed-decision-activation.ts",
    "managed:backup": "node --env-file-if-exists=.env --import tsx scripts/managed-backup.ts",
    "managed:restore": "node --env-file-if-exists=.env --import tsx scripts/managed-restore.ts",
    "managed:billing": "node --env-file-if-exists=.env --import tsx scripts/managed-billing.ts",
    "managed:reconcile": "node --env-file-if-exists=.env --import tsx scripts/managed-reconcile.ts",
    "vault:dry-run": "node --env-file-if-exists=.env --import tsx scripts/vault.ts dry-run",
    "vault:migrate": "node --env-file-if-exists=.env --import tsx scripts/vault.ts migrate",
    "vault:rebuild": "node --env-file-if-exists=.env --import tsx scripts/vault.ts rebuild",
    "vault:rollback": "node --env-file-if-exists=.env --import tsx scripts/vault.ts rollback",
    "vault:finalize-forget": "node --env-file-if-exists=.env --import tsx scripts/finalize-forget.ts",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env --import tsx scripts/restore.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@fontsource-variable/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fastify": "5.12.5",
    "openid-client": "6.8.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
