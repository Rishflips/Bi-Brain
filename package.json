{
  "name": "bi-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/run.mjs dev",
    "start": "node --env-file-if-exists=.env scripts/run.mjs production",
    "server": "node --env-file-if-exists=.env --import tsx apps/server/main.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/main.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env --import tsx scripts/restore.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@modelcontextprotocol/sdk": "1.30.1",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
