# BiBrain's Connections screen writes this file for you: open Connections and choose "Add to Codex".
# This example is only for setting it up by hand. Copy it to .codex/config.toml on a trusted local checkout.
# Keep BRAIN_AGENT_TOKEN in the environment; never put it in this file.
[mcp_servers.bibrain]
command = "node"
args = ["node_modules/tsx/dist/cli.mjs", "apps/mcp/main.ts"]
cwd = "."
env_vars = ["BRAIN_AGENT_TOKEN", "BRAIN_API_URL"]
startup_timeout_sec = 15
tool_timeout_sec = 60
required = false
default_tools_approval_mode = "writes"
